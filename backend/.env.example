# EcoReason Environment Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=True

# Google Gemini API Key
# Get a key from https://aistudio.google.com/
GEMINI_API_KEY=

# Database URL (Defaults to local SQLite, can be swapped for PostgreSQL in production)
DATABASE_URL=sqlite:///./ecoreason.db

# Fallback Mode: if True, will use built-in scientific synthesizer when API key is missing or quota is reached
ALLOW_MOCK_FALLBACK=True
